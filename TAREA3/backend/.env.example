PORT=8080
JWT_SECRET=cambia-esta-clave-en-produccion
CORS_ORIGIN=http://18.191.113.248

# --- PostgreSQL en AWS RDS ---------------------------------------------------
# Endpoint: consola de AWS > RDS > Bases de datos > (tu base) > "Punto de enlace".
PGHOST=movimiento-db.xxxxxxxxxxxx.us-east-2.rds.amazonaws.com
PGPORT=5432
PGUSER=postgres
PGPASSWORD=tu-contraseña-de-rds
PGDATABASE=movimiento
# RDS exige SSL. El certificado se descarga en certs/ con actualizar_servidor.py.
PGSSLMODE=require
# Conexiones simultáneas a la base de datos.
PGPOOL_MAX=10

# Solo para migrar los datos antiguos (archivos JSON) a PostgreSQL.
DB_FILE=./data/movimiento.json
