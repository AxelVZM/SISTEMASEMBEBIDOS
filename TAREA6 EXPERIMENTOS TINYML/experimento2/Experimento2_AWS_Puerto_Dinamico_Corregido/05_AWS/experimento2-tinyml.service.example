[Unit]
Description=Experimento 2 TinyML AWS
After=network.target
[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/SISTEMASEMBEBIDOS/TAREA6 EXPERIMENTOS TINYML/experimento2/05_AWS
EnvironmentFile=/etc/experimento2-tinyml.env
ExecStart=/home/ubuntu/SISTEMASEMBEBIDOS/.venv-exp2/bin/gunicorn -w 1 --threads 4 -b 127.0.0.1:18762 server:app
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
